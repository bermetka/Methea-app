# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Paddle — sandbox values for local dev; production values only in Vercel Production
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
# Price variants (A/B test): one-time, per project
NEXT_PUBLIC_PADDLE_PRICE_ID_A=
NEXT_PUBLIC_PADDLE_PRICE_ID_B=
# Escape the $ everywhere, including the Vercel dashboard: Next.js expands $NAME in
# env values (files AND the real environment), so a bare $49 becomes empty.
NEXT_PUBLIC_PRICE_LABEL_A=\$49
NEXT_PUBLIC_PRICE_LABEL_B=\$99
# Server-side copies of the price ids: the webhook only unlocks projects for these
# (the Paddle account is shared with o-nion and SOLA)
PADDLE_PRICE_ID_A=
PADDLE_PRICE_ID_B=
# Founding-tester banner end date (display only; Paddle enforces the code's expiry)
NEXT_PUBLIC_FOUNDING_UNTIL=2026-11-23
PADDLE_WEBHOOK_SECRET=

# Paywall start (ISO with offset). Before it every project behaves as paid.
# Missing or invalid = paywall active. Prod: 2026-11-01T00:00:00+06:00
PAYWALL_START=2026-11-01T00:00:00+06:00
