  "core_idea": "Migrants build social fields that link their country of origin and settlement. They live across borders, keeping economic, family and political ties in both places at once.",
  "key_concepts_note": "Use the concepts already stored for this theory in the library (theories.concepts).",
  "when_to_use": [
    "How do labour migrants keep ties with home (remittances, families, politics)?",
    "How do diasporas organise across borders?",
    "Typical data: multi-sited ethnography, interviews, surveys."
  ],
  "common_mistakes": [
    "Assuming all migrants are transnational.",
    "Ignoring the state, which still matters.",
    "Methodological nationalism: studying only one side."
  ],
