  "when_to_use": [
    "How ready are people to change a behaviour?",
    "Do stage-matched interventions work better?",
    "Typical data: stage questionnaires, longitudinal surveys, interviews."
  ],
  "common_mistakes": [
    "Using stages without processes of change.",
    "Assuming linear movement; relapse is common.",
    "Using the model for behaviours it wasn't built for without adaptation."
