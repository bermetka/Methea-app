  "when_to_use": [
    "How do teachers respond to curriculum reform?",
    "What conditions enable or limit teachers' professional judgement?",
    "Typical data: interviews, case study, observation."
  ],
  "common_mistakes": [
    "Treating agency as a personal trait.",
    "Ignoring the cultural and structural conditions the approach stresses.",
    "Equating agency with resistance."
