  "when_to_use": [
    "How do activists or NGOs present an issue to mobilise supporters?",
    "Why do some campaigns resonate and others don't?",
    "Typical data: frame analysis of texts, interviews, content analysis."
  ],
  "common_mistakes": [
    "Confusing movement framing with media framing.",
    "Listing frames without diagnostic, prognostic and motivational tasks.",
