  "core_idea": "Health behaviour is shaped at several nested levels: individual, interpersonal, organisational, community and public policy. Interventions work better when they target more than one level.",
  "key_concepts_note": "Use the concepts already stored for this theory in the library (theories.concepts).",
  "when_to_use": [
    "What influences a health behaviour at different levels?",
    "How should a multi-level health intervention be designed?",
    "Typical data: mixed methods, surveys, interviews, policy analysis."
  ],
  "common_mistakes": [
    "Listing levels without analysing interactions.",
    "Claiming a 'multi-level' study with individual data only.",
    "Confusing it with Bronfenbrenner's developmental model (own library entry)."
  ],
