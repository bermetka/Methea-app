  "when_to_use": [
    "How do rural or migrant households make a living and cope with shocks?",
    "How do institutions shape access to assets?",
    "Typical data: household surveys, interviews, participatory methods."
  ],
  "common_mistakes": [
    "Using the five capitals as a checklist without institutions and power.",
    "Ignoring the vulnerability context.",
    "Treating households as harmonious units."
